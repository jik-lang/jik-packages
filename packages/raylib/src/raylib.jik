// Android key buttons.
KEY_BACK := 4
KEY_MENU := 5
KEY_VOLUME_UP := 24
KEY_VOLUME_DOWN := 25

MOUSE_BUTTON_LEFT := 0
MOUSE_BUTTON_RIGHT := 1
MOUSE_BUTTON_MIDDLE := 2

// -----------------------------------------------------------------------------
// Native boundary
// -----------------------------------------------------------------------------

@embed{RAYLIB_C_END}

#ifdef _WIN32
#define Rectangle RaylibRectangle
#define CloseWindow RaylibCloseWindow
#define ShowCursor RaylibShowCursor

#pragma push_macro("LoadImage")
#pragma push_macro("DrawText")
#pragma push_macro("DrawTextEx")
#pragma push_macro("PlaySound")
#undef LoadImage
#undef DrawText
#undef DrawTextEx
#undef PlaySound
#endif

#include "raylib.h"

#ifdef _WIN32
#undef ShowCursor
#undef CloseWindow
#undef Rectangle

extern void RaylibCloseWindow(void) __asm__("CloseWindow");
#define JIK_RAYLIB_RECTANGLE RaylibRectangle
#else
#define JIK_RAYLIB_RECTANGLE Rectangle
#endif

static Color
jik_raylib_color(int r, int g, int b, int a)
{
    return (Color){(unsigned char)r, (unsigned char)g,
                   (unsigned char)b, (unsigned char)a};
}

static Vector2
jik_raylib_vector2(double x, double y)
{
    return (Vector2){(float)x, (float)y};
}

static JIK_RAYLIB_RECTANGLE
jik_raylib_rectangle(double x, double y, double width, double height)
{
    return (JIK_RAYLIB_RECTANGLE){(float)x, (float)y, (float)width, (float)height};
}

static void
jik_raylib_init_window(int width, int height, JikString *title)
{
    InitWindow(width, height, title->data);
}

static void
jik_raylib_set_window_title(JikString *title)
{
    SetWindowTitle(title->data);
}

static void
jik_raylib_close_window(void)
{
#ifdef _WIN32
    RaylibCloseWindow();
#else
    CloseWindow();
#endif
}

static void
jik_raylib_clear_background(int r, int g, int b, int a)
{
    ClearBackground(jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_pixel(double x, double y, int r, int g, int b, int a)
{
    DrawPixel((int)x, (int)y, jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_line(double x1, double y1, double x2, double y2,
                     int r, int g, int b, int a)
{
    DrawLineV(jik_raylib_vector2(x1, y1),
              jik_raylib_vector2(x2, y2),
              jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_rectangle(double x, double y, double width, double height,
                          int r, int g, int b, int a)
{
    DrawRectangleRec(jik_raylib_rectangle(x, y, width, height),
                     jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_rectangle_lines(double x, double y, double width, double height,
                                int r, int g, int b, int a)
{
    DrawRectangleLinesEx(jik_raylib_rectangle(x, y, width, height), 1.0f,
                         jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_circle(double x, double y, double radius,
                       int r, int g, int b, int a)
{
    DrawCircleV(jik_raylib_vector2(x, y), (float)radius,
                jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_circle_lines(double x, double y, double radius,
                             int r, int g, int b, int a)
{
    DrawCircleLinesV(jik_raylib_vector2(x, y), (float)radius,
                     jik_raylib_color(r, g, b, a));
}

static void
jik_raylib_draw_text(JikString *text, int x, int y, int size,
                     int r, int g, int b, int a)
{
    DrawText(text->data, x, y, size, jik_raylib_color(r, g, b, a));
}

static int
jik_raylib_measure_text(JikString *text, int size)
{
    return MeasureText(text->data, size);
}

static const char *
jik_raylib_find_asset(JikString *path, JikRegion *region);

typedef struct jik_raylib_font {
    Font value;
    bool loaded;
} jik_raylib_font;

static jik_raylib_font *
jik_raylib_font_new(JikRegion *region)
{
    jik_raylib_font *font = jik_region_alloc(region, sizeof(jik_raylib_font));
    font->value = (Font){0};
    font->loaded = false;
    return font;
}

static jik_raylib_font *
jik_raylib_load_font(JikString *path, JikRegion *region)
{
    jik_raylib_font *font = jik_raylib_font_new(region);
    if (IsWindowReady()) {
        font->value = LoadFont(jik_raylib_find_asset(path, region));
        font->loaded = IsFontValid(font->value);
    }
    return font;
}

static bool
jik_raylib_is_font_valid(jik_raylib_font *font)
{
    return font->loaded;
}

static void
jik_raylib_draw_font_text(jik_raylib_font *font, JikString *text,
                          double x, double y, double size, double spacing,
                          int r, int g, int b, int a)
{
    if (font->loaded) {
        DrawTextEx(font->value, text->data, jik_raylib_vector2(x, y),
                   (float)size, (float)spacing, jik_raylib_color(r, g, b, a));
    }
}

static double
jik_raylib_measure_font_text_width(jik_raylib_font *font, JikString *text,
                                   double size, double spacing)
{
    if (!font->loaded) return 0.0;
    return (double)MeasureTextEx(font->value, text->data,
                                 (float)size, (float)spacing).x;
}

static double
jik_raylib_measure_font_text_height(jik_raylib_font *font, JikString *text,
                                    double size, double spacing)
{
    if (!font->loaded) return 0.0;
    return (double)MeasureTextEx(font->value, text->data,
                                 (float)size, (float)spacing).y;
}

static void
jik_raylib_unload_font(jik_raylib_font *font)
{
    if (font->loaded) {
        UnloadFont(font->value);
        font->loaded = false;
    }
}

static double
jik_raylib_mouse_x(void)
{
    return (double)GetMousePosition().x;
}

static double
jik_raylib_mouse_y(void)
{
    return (double)GetMousePosition().y;
}

static const char *
jik_raylib_find_asset(JikString *path, JikRegion *region)
{
    const char *filename = path->data;
    if (FileExists(filename)) {
        return filename;
    }

    const char *directory = GetApplicationDirectory();
    size_t directory_len = strlen(directory);
    bool has_separator = directory_len > 0 &&
        (directory[directory_len - 1] == '/' || directory[directory_len - 1] == '\\');
    size_t path_len = strlen(filename);
    size_t result_len = directory_len + path_len + (has_separator ? 1 : 2);
    char *beside_executable = jik_region_alloc(region, result_len);
    snprintf(beside_executable, result_len,
             has_separator ? "%s%s" : "%s/%s", directory, filename);
    return beside_executable;
}

typedef struct jik_raylib_sound {
    Sound value;
    bool loaded;
} jik_raylib_sound;

static jik_raylib_sound *
jik_raylib_sound_new(JikRegion *region)
{
    jik_raylib_sound *sound = jik_region_alloc(region, sizeof(jik_raylib_sound));
    sound->loaded = false;
    return sound;
}

static jik_raylib_sound *
jik_raylib_load_sound(JikString *path, JikRegion *region)
{
    jik_raylib_sound *sound = jik_raylib_sound_new(region);
    if (IsAudioDeviceReady()) {
        sound->value = LoadSound(jik_raylib_find_asset(path, region));
        sound->loaded = IsSoundValid(sound->value);
    }
    return sound;
}

static bool
jik_raylib_is_sound_valid(jik_raylib_sound *sound)
{
    return sound->loaded;
}

static void
jik_raylib_play_sound(jik_raylib_sound *sound)
{
    if (sound->loaded) {
        PlaySound(sound->value);
    }
}

static void
jik_raylib_set_sound_volume(jik_raylib_sound *sound, double volume)
{
    if (sound->loaded) {
        SetSoundVolume(sound->value, (float)volume);
    }
}

static void
jik_raylib_unload_sound(jik_raylib_sound *sound)
{
    if (sound->loaded) {
        UnloadSound(sound->value);
        sound->loaded = false;
    }
}

typedef struct jik_raylib_music {
    Music value;
    bool loaded;
} jik_raylib_music;

static jik_raylib_music *
jik_raylib_music_new(JikRegion *region)
{
    jik_raylib_music *music = jik_region_alloc(region, sizeof(jik_raylib_music));
    music->loaded = false;
    return music;
}

static jik_raylib_music *
jik_raylib_load_music(JikString *path, JikRegion *region)
{
    jik_raylib_music *music = jik_raylib_music_new(region);
    if (IsAudioDeviceReady()) {
        music->value = LoadMusicStream(jik_raylib_find_asset(path, region));
        music->loaded = IsMusicValid(music->value);
    }
    return music;
}

static bool
jik_raylib_is_music_valid(jik_raylib_music *music)
{
    return music->loaded;
}

static void
jik_raylib_play_music(jik_raylib_music *music)
{
    if (music->loaded) PlayMusicStream(music->value);
}

static bool
jik_raylib_is_music_playing(jik_raylib_music *music)
{
    return music->loaded && IsMusicStreamPlaying(music->value);
}

static void
jik_raylib_update_music(jik_raylib_music *music)
{
    if (music->loaded) UpdateMusicStream(music->value);
}

static void
jik_raylib_stop_music(jik_raylib_music *music)
{
    if (music->loaded) StopMusicStream(music->value);
}

static void
jik_raylib_pause_music(jik_raylib_music *music)
{
    if (music->loaded) PauseMusicStream(music->value);
}

static void
jik_raylib_resume_music(jik_raylib_music *music)
{
    if (music->loaded) ResumeMusicStream(music->value);
}

static void
jik_raylib_set_music_looping(jik_raylib_music *music, bool looping)
{
    if (music->loaded) music->value.looping = looping;
}

static void
jik_raylib_set_music_volume(jik_raylib_music *music, double volume)
{
    if (music->loaded) SetMusicVolume(music->value, (float)volume);
}

static double
jik_raylib_music_time_length(jik_raylib_music *music)
{
    return music->loaded ? (double)GetMusicTimeLength(music->value) : 0.0;
}

static double
jik_raylib_music_time_played(jik_raylib_music *music)
{
    return music->loaded ? (double)GetMusicTimePlayed(music->value) : 0.0;
}

static void
jik_raylib_unload_music(jik_raylib_music *music)
{
    if (music->loaded) {
        UnloadMusicStream(music->value);
        music->loaded = false;
    }
}

typedef struct jik_raylib_texture {
    Texture2D value;
    bool loaded;
} jik_raylib_texture;

static jik_raylib_texture *
jik_raylib_texture_new(JikRegion *region)
{
    jik_raylib_texture *texture = jik_region_alloc(region, sizeof(jik_raylib_texture));
    texture->value = (Texture2D){0};
    texture->loaded = false;
    return texture;
}

static jik_raylib_texture *
jik_raylib_load_texture(JikString *path, JikRegion *region)
{
    jik_raylib_texture *texture = jik_raylib_texture_new(region);
    if (IsWindowReady()) {
        texture->value = LoadTexture(jik_raylib_find_asset(path, region));
        texture->loaded = IsTextureValid(texture->value);
    }
    return texture;
}

static bool
jik_raylib_is_texture_valid(jik_raylib_texture *texture)
{
    return texture->loaded;
}

static int
jik_raylib_texture_width(jik_raylib_texture *texture)
{
    if (texture->loaded) {
        return texture->value.width;
    }
    return 0;
}

static int
jik_raylib_texture_height(jik_raylib_texture *texture)
{
    if (texture->loaded) {
        return texture->value.height;
    }
    return 0;
}

static void
jik_raylib_set_texture_filter_point(jik_raylib_texture *texture)
{
    if (texture->loaded) {
        SetTextureFilter(texture->value, TEXTURE_FILTER_POINT);
    }
}

static void
jik_raylib_draw_texture_rect(jik_raylib_texture *texture,
                             double source_x, double source_y,
                             double source_width, double source_height,
                             double dest_x, double dest_y,
                             double dest_width, double dest_height,
                             int r, int g, int b, int a)
{
    if (texture->loaded) {
        DrawTexturePro(texture->value,
                       jik_raylib_rectangle(source_x, source_y, source_width, source_height),
                       jik_raylib_rectangle(dest_x, dest_y, dest_width, dest_height),
                       (Vector2){0.0f, 0.0f}, 0.0f,
                       jik_raylib_color(r, g, b, a));
    }
}

static void
jik_raylib_unload_texture(jik_raylib_texture *texture)
{
    if (texture->loaded) {
        UnloadTexture(texture->value);
        texture->loaded = false;
    }
}

#ifdef _WIN32
#pragma pop_macro("PlaySound")
#pragma pop_macro("DrawTextEx")
#pragma pop_macro("DrawText")
#pragma pop_macro("LoadImage")
#endif

RAYLIB_C_END


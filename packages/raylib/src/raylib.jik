KEY_SPACE := 32
KEY_ESCAPE := 256
KEY_ENTER := 257
KEY_TAB := 258
KEY_BACKSPACE := 259
KEY_INSERT := 260
KEY_DELETE := 261
KEY_RIGHT := 262
KEY_LEFT := 263
KEY_DOWN := 264
KEY_UP := 265
KEY_PAGE_UP := 266
KEY_PAGE_DOWN := 267
KEY_HOME := 268
KEY_END := 269
KEY_CAPS_LOCK := 280
KEY_SCROLL_LOCK := 281
KEY_NUM_LOCK := 282
KEY_PRINT_SCREEN := 283
KEY_PAUSE := 284
KEY_F1 := 290
KEY_F2 := 291
KEY_F3 := 292
KEY_F4 := 293
KEY_F5 := 294
KEY_F6 := 295
KEY_F7 := 296
KEY_F8 := 297
KEY_F9 := 298
KEY_F10 := 299
KEY_F11 := 300
KEY_F12 := 301

KEY_KP_0 := 320
KEY_KP_1 := 321
KEY_KP_2 := 322
KEY_KP_3 := 323
KEY_KP_4 := 324
KEY_KP_5 := 325
KEY_KP_6 := 326
KEY_KP_7 := 327
KEY_KP_8 := 328
KEY_KP_9 := 329

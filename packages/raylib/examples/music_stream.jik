//! Stream looping background music.
//!
//! The bundled `assets/background.ogg` is a CC0 loop. Replace it with an OGG,
//! MP3, WAV, FLAC, or other raylib-supported music file as desired.

use "pkg/raylib" as rl


func main():
    rl::init_window(800, 450, "Jik raylib music stream")
    rl::set_target_fps(60)
    rl::init_audio_device()

    music := rl::load_music("assets/background.ogg", _)
    if rl::is_music_valid(music):
        rl::set_music_looping(music, true)
        rl::set_music_volume(music, 0.45)
        rl::play_music(music)
    end

    while not rl::window_should_close():
        // Required every frame to refill raylib's streaming audio buffers.
        rl::update_music_stream(music)

        if rl::is_music_valid(music) and rl::is_key_pressed(rl::KEY_SPACE):
            if rl::is_music_playing(music):
                rl::pause_music(music)
            else:
                rl::resume_music(music)
            end
        end

        rl::begin_drawing()
        rl::clear_background(rl::RAYWHITE)
        rl::draw_text("Background music streaming", 190, 130, 30, rl::DARKGRAY)
        if rl::is_music_valid(music):
            rl::draw_text("Space: pause or resume", 248, 190, 22, rl::BLUE)
            rl::draw_text("update_music_stream() runs every frame", 176, 230, 20, rl::DARKGRAY)
        else:
            rl::draw_text("Could not load assets/background.ogg", 180, 205, 20, rl::RED)
        end
        rl::end_drawing()
    end

    rl::unload_music(music)
    rl::close_audio_device()
    rl::close_window()
end

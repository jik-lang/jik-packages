use "jik/testing" as test
use "../src/raylib"

func run_tests(ts):
    test::suite_assert(ts, raylib::WHITE.r == 255, site())
    test::suite_assert(ts, raylib::WHITE.a == 255, site())
    test::suite_assert(ts, raylib::KEY_ESCAPE == 256, site())
    test::suite_assert(ts, raylib::KEY_A == 65, site())
    test::suite_assert(ts, raylib::KEY_F12 == 301, site())
    test::suite_assert(ts, raylib::KEY_KP_ENTER == 335, site())
    test::suite_assert(ts, raylib::KEY_RIGHT_SUPER == 347, site())
    test::suite_assert(ts, raylib::MOUSE_BUTTON_LEFT == 0, site())
    sound := raylib::Sound{}
    test::suite_assert(ts, not raylib::is_sound_valid(sound), site())
    music := raylib::Music{}
    test::suite_assert(ts, not raylib::is_music_valid(music), site())
    test::suite_assert(ts, not raylib::is_music_playing(music), site())
    test::suite_assert(ts, raylib::music_time_length(music) == 0.0, site())
    texture := raylib::Texture{}
    test::suite_assert(ts, not raylib::is_texture_valid(texture), site())
    test::suite_assert(ts, raylib::texture_width(texture) == 0, site())
    test::suite_assert(ts, raylib::texture_height(texture) == 0, site())
    font := raylib::Font{}
    test::suite_assert(ts, not raylib::is_font_valid(font), site())
    size := raylib::measure_font_text(font, "test", 24.0, 1.0, _)
    test::suite_assert(ts, size.x == 0.0, site())
    test::suite_assert(ts, size.y == 0.0, site())
end

func main():
    ts := test::suite_new(_)
    run_tests(ts)
    test::suite_finish(ts)
end
